cabal-version:      3.0
name:               ghc-lib-parser-test
version:            0.1.0.0
synopsis:           AST extraction test with ghc-lib-parser (HLS infrastructure)
description:
  Test project for the technical analysis of ghc-lib-parser,
  the parsing library used internally by haskell-language-server.
  Demonstrates AST extraction using the real GHC parser.
author:             Saraqch
maintainer:         quispechoquesara@gmail.com

executable ghc-lib-parser-test
    main-is:          Main.hs
    hs-source-dirs:   objective1/src shared
    other-modules:    HaskellSourceParser
    default-language: Haskell2010
    build-depends:
        base              >= 4.14 && < 5,
        directory         >= 1.3,
        ghc-paths         >= 0.1,
        ghc-lib    == 9.6.7.20250325

executable ghc-lib-ast-prose
    main-is:          AstOnlyProseMain.hs
    hs-source-dirs:   objective2/app objective2/src
    other-modules:
        Analysis.RenamedAstFacts
        Analysis.Typechecker
        Prose.AstProseGenerator
    default-language: Haskell2010
    build-depends:
        base              >= 4.14 && < 5,
        directory         >= 1.3,
        ghc-paths         >= 0.1,
        prettyprinter     >= 1.7 && < 2,
        ghc-lib    == 9.6.7.20250325

executable ghc-lib-typed-ast-prose
    main-is:          TypeEnrichedProseMain.hs
    hs-source-dirs:   objective2/app objective2/src
    other-modules:
        Analysis.RenamedAstFacts
        Analysis.Typechecker
        Analysis.TypedAstFacts
        Prose.AstProseGenerator
        Prose.TypeProseGenerator
    default-language: Haskell2010
    build-depends:
        base              >= 4.14 && < 5,
        directory         >= 1.3,
        ghc-paths         >= 0.1,
        prettyprinter     >= 1.7 && < 2,
        ghc-lib    == 9.6.7.20250325

 
