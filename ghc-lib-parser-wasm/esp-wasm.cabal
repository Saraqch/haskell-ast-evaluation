cabal-version:      3.0
name:               esp-wasm
version:            0.1.0.0
synopsis:           Parser-only ESP prose engine compiled to WebAssembly
author:             Saraqch
maintainer:         quispechoquesara@gmail.com

executable esp-wasm
    main-is:          WasmMain.hs
    hs-source-dirs:
        app
        ../ghc-lib-parser/shared
        ../ghc-lib-parser/objective2/src
    other-modules:
        Analysis.ResolvedGuard
        HaskellSourceParser
        Prose.AstProseGenerator
    default-language: Haskell2010
    ghc-options:      -O1
    build-depends:
        base              >= 4.14 && < 5,
        directory         >= 1.3,
        prettyprinter     >= 1.7 && < 2,
        ghc-lib-parser    == 9.6.7.20250325
